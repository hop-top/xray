{
  "name": "xray",
  "version": "0.0.1-alpha.1",
  "description": "X-ray your codebase - Generate AST, CFG, and DFG visualizations",
  "main": "dist/index.js",
  "bin": {
    "xray": "bin/xray"
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.strategies.json && cp -r src/lib/parser/queries dist/lib/parser/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "./scripts/test-sequential.sh",
    "test:parallel": "jest",
    "test:coverage": "./scripts/test-coverage.sh",
    "prepare-public": "./scripts/prepare-public.sh",
    "prepare": "husky install",
    "strategy:detect": "node dist/index.js strategy:detect"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.0.0",
    "glob": "^10.3.10",
    "graphology": "^0.25.4",
    "graphology-metrics": "^2.2.0",
    "ignore": "^5.3.0",
    "js-yaml": "^4.1.1",
    "llm-cost": "^1.0.5"
  },
  "devDependencies": {
    "@ganezdragon/tree-sitter-perl": "^1.1.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cli-progress": "^3.11.6",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "graphology-types": "^0.24.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-elixir": "^0.3.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-lua": "^2.1.3",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-r": "^0.0.1-security",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  }
}
