{
  "name": "@hop-top/xray",
  "version": "0.1.0-rc.0",
  "description": "X-ray your codebase - Generate AST, CFG, and DFG visualizations",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./strategy": {
      "types": "./dist/lib/strategy/types.d.ts",
      "default": "./dist/lib/strategy/types.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "strategy": [
        "dist/lib/strategy/types.d.ts"
      ]
    }
  },
  "bin": {
    "xray": "bin/xray"
  },
  "files": [
    "bin/xray",
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "ast",
    "code-analysis",
    "codebase",
    "cfg",
    "dfg",
    "tree-sitter",
    "visualization",
    "ai",
    "llm",
    "code-map",
    "pagerank",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hop-top/xray.git"
  },
  "homepage": "https://github.com/hop-top/xray",
  "bugs": {
    "url": "https://github.com/hop-top/xray/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc --project tsconfig.declarations.json && tsc --project tsconfig.strategies.json && cp -r src/lib/parser/queries dist/lib/parser/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "./scripts/test-sequential.sh",
    "test:parallel": "jest",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:coverage": "./scripts/test-coverage.sh",
    "prepublishOnly": "npm run build && npm test",
    "strategy:detect": "node dist/index.js strategy detect",
    "hooks": "husky"
  },
  "dependencies": {
    "@hop-top/kit": "0.5.0-alpha.11",
    "@iarna/toml": "^2.2.5",
    "commander": "15.0.0",
    "csv-stringify": "^6.9.0",
    "glob": "^10.3.10",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "2.0.2",
    "graphology-metrics": "^2.2.0",
    "ignore": "^5.3.0",
    "js-yaml": "^4.1.1",
    "llm-cost": "^1.0.5",
    "tree-sitter": "^0.25.1"
  },
  "devDependencies": {
    "@types/iarna__toml": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.3",
    "graphology-types": "^0.24.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-elixir": "^0.3.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-elixir": "^0.3.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "peerDependenciesMeta": {
    "tree-sitter-bash": {
      "optional": true
    },
    "tree-sitter-c": {
      "optional": true
    },
    "tree-sitter-c-sharp": {
      "optional": true
    },
    "tree-sitter-cpp": {
      "optional": true
    },
    "tree-sitter-elixir": {
      "optional": true
    },
    "tree-sitter-go": {
      "optional": true
    },
    "tree-sitter-haskell": {
      "optional": true
    },
    "tree-sitter-java": {
      "optional": true
    },
    "tree-sitter-javascript": {
      "optional": true
    },
    "tree-sitter-kotlin": {
      "optional": true
    },
    "tree-sitter-php": {
      "optional": true
    },
    "tree-sitter-python": {
      "optional": true
    },
    "tree-sitter-ruby": {
      "optional": true
    },
    "tree-sitter-rust": {
      "optional": true
    },
    "tree-sitter-scala": {
      "optional": true
    },
    "tree-sitter-swift": {
      "optional": true
    },
    "tree-sitter-typescript": {
      "optional": true
    }
  },
  "overrides": {
    "tree-sitter": "$tree-sitter"
  }
}
