exports[`cli golden: --help xray query --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray query [options] [query]

Query call graph using function-based syntax

ARGUMENTS:
  query              Query string (e.g., "calls(main)", "callers(processData)")

FLAGS:
  --graph <file>     Read a saved graph (map --format json) instead of building
                     one
  -p, --path <path>  Root directory to analyze (repeatable) [default: config
                     paths or current directory] (default: [])
  --lens <name>      Use named lens (config-file option overlay)
  --scope <name>     Use specific scope from config file
  --lang <list>      Languages to parse, comma-separated names or bundles
                     (repeatable) (default: [])
  --format <fmt>     Output format: table, json, yaml, csv, tree (default:
                     table) (default: "table")
  --list-adapters    List available query adapters
  -h, --help         Display help


Without --graph the graph is built in memory for the configured roots
(--path, --lens, --scope; same resolution as \`impact\` and \`map --format
json\`) and no map file is written.

Examples:
  xray query "calls(main)"
  xray query -p ./api "callers(validateInput)"
  xray query --graph graph.json "calls(main)"


--- stderr ---
"
`;

