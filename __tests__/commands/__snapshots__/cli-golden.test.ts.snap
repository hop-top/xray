exports[`cli golden: --help xray go-cli commands --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray go-cli commands [options]

Show the CLI command tree (AST by default; toolspec via --exec-binary/--binary)

Options:
  -p, --path <path>                   Project path to analyze (default:
                                      "<CWD>")
  --enable-extension <name>           Enable an extension at runtime
                                      (repeatable) (default: [])
  --disable-extension <name>          Disable an extension at runtime
                                      (repeatable) (default: [])
