exports[`cli golden: introspection completion bash 1`] = `
"exit: 0
--- stdout ---
# xray completion for bash
# Add to ~/.bashrc or ~/.bash_profile:
# eval "$(xray completion bash)"

_xray_completions() {
  local cur prev commands
  COMPREPLY=()
  cur="\${COMP_WORDS[COMP_CWORD]}"
  prev="\${COMP_WORDS[COMP_CWORD-1]}"
  commands="map scan graph generate query strategy alias lang explore clear-cache completion help build cicd config container express go-cli infrastructure markdown package-manager react rest-api"

  # First level: main commands
  if [ $COMP_CWORD -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  # Second level: strategy subcommands
  local main_cmd="\${COMP_WORDS[1]}"
  case "$main_cmd" in
    build)
      COMPREPLY=( $(compgen -W "targets graph run" -- "$cur") )
      return 0
      ;;
    cicd)
      COMPREPLY=( $(compgen -W "workflows graph deploy triggers" -- "$cur") )
      return 0
      ;;
    config)
      COMPREPLY=( $(compgen -W "list keys values" -- "$cur") )
      return 0
      ;;
    container)
      COMPREPLY=( $(compgen -W "analyze services stages" -- "$cur") )
      return 0
      ;;
    express)
      COMPREPLY=( $(compgen -W "routes routers middleware error-handlers" -- "$cur") )
      return 0
      ;;
    go-cli)
      COMPREPLY=( $(compgen -W "commands" -- "$cur") )
      return 0
      ;;
    infrastructure)
      COMPREPLY=( $(compgen -W "resources providers graph summary validate" -- "$cur") )
      return 0
      ;;
    markdown)
      COMPREPLY=( $(compgen -W "toc refs orphans code-refs coverage stale" -- "$cur") )
      return 0
      ;;
    package-manager)
      COMPREPLY=( $(compgen -W "list-dependencies summary" -- "$cur") )
      return 0
      ;;
    react)
      COMPREPLY=( $(compgen -W "components hooks contexts" -- "$cur") )
      return 0
      ;;
    rest-api)
      COMPREPLY=( $(compgen -W "endpoints methods middleware" -- "$cur") )
      return 0
      ;;
  esac

  # Option completions
  case "$prev" in
    -p|--path|-o|--output|-a|--anchor|--config|--graph)
      COMPREPLY=( $(compgen -f -- "$cur") )
      return 0
      ;;
    --format)
      COMPREPLY=( $(compgen -W "txt csv xml json mermaid dot table tree text" -- "$cur") )
      return 0
      ;;
    *)
      COMPREPLY=( $(compgen -W "--path --output --limit --anchor --depth --query --match --graph --format --json --csv --xml --txt --mermaid --dot --help" -- "$cur") )
      return 0
      ;;
  esac
}

complete -F _xray_completions xray

--- stderr ---
"
`;

exports[`cli golden: introspection completion fish 1`] = `
"exit: 0
--- stdout ---
# xray completion for fish
# Save to ~/.config/fish/completions/xray.fish

# Core commands
complete -c xray -n '__fish_use_subcommand' -a map -d 'Generate visual map of codebase'
complete -c xray -n '__fish_use_subcommand' -a scan -d 'Scan and discover files'
complete -c xray -n '__fish_use_subcommand' -a graph -d 'Generate CFG and DFG graphs'
complete -c xray -n '__fish_use_subcommand' -a generate -d 'Generate analysis visualization'
complete -c xray -n '__fish_use_subcommand' -a query -d 'Query call graph'
complete -c xray -n '__fish_use_subcommand' -a strategy -d 'Manage strategies'
complete -c xray -n '__fish_use_subcommand' -a alias -d 'Manage aliases'
complete -c xray -n '__fish_use_subcommand' -a lang -d 'Manage language packs (tree-sitter grammars)'
complete -c xray -n '__fish_use_subcommand' -a explore -d 'Find files and search code'
complete -c xray -n '__fish_use_subcommand' -a clear-cache -d 'Clear SQLite cache'
complete -c xray -n '__fish_use_subcommand' -a completion -d 'Generate shell completion'
complete -c xray -n '__fish_use_subcommand' -a help -d 'Display help'

# Strategy subcommands
complete -c xray -n '__fish_seen_subcommand_from build' -a targets -d 'build targets command'
complete -c xray -n '__fish_seen_subcommand_from build' -a graph -d 'build graph command'
complete -c xray -n '__fish_seen_subcommand_from build' -a run -d 'build run command'

complete -c xray -n '__fish_seen_subcommand_from cicd' -a workflows -d 'cicd workflows command'
complete -c xray -n '__fish_seen_subcommand_from cicd' -a graph -d 'cicd graph command'
complete -c xray -n '__fish_seen_subcommand_from cicd' -a deploy -d 'cicd deploy command'
complete -c xray -n '__fish_seen_subcommand_from cicd' -a triggers -d 'cicd triggers command'

complete -c xray -n '__fish_seen_subcommand_from config' -a list -d 'config list command'
complete -c xray -n '__fish_seen_subcommand_from config' -a keys -d 'config keys command'
complete -c xray -n '__fish_seen_subcommand_from config' -a values -d 'config values command'

complete -c xray -n '__fish_seen_subcommand_from container' -a analyze -d 'container analyze command'
complete -c xray -n '__fish_seen_subcommand_from container' -a services -d 'container services command'
complete -c xray -n '__fish_seen_subcommand_from container' -a stages -d 'container stages command'

complete -c xray -n '__fish_seen_subcommand_from express' -a routes -d 'express routes command'
complete -c xray -n '__fish_seen_subcommand_from express' -a routers -d 'express routers command'
complete -c xray -n '__fish_seen_subcommand_from express' -a middleware -d 'express middleware command'
complete -c xray -n '__fish_seen_subcommand_from express' -a error-handlers -d 'express error-handlers command'

complete -c xray -n '__fish_seen_subcommand_from go-cli' -a commands -d 'go-cli commands command'

complete -c xray -n '__fish_seen_subcommand_from infrastructure' -a resources -d 'infrastructure resources command'
complete -c xray -n '__fish_seen_subcommand_from infrastructure' -a providers -d 'infrastructure providers command'
complete -c xray -n '__fish_seen_subcommand_from infrastructure' -a graph -d 'infrastructure graph command'
complete -c xray -n '__fish_seen_subcommand_from infrastructure' -a summary -d 'infrastructure summary command'
complete -c xray -n '__fish_seen_subcommand_from infrastructure' -a validate -d 'infrastructure validate command'

complete -c xray -n '__fish_seen_subcommand_from markdown' -a toc -d 'markdown toc command'
complete -c xray -n '__fish_seen_subcommand_from markdown' -a refs -d 'markdown refs command'
complete -c xray -n '__fish_seen_subcommand_from markdown' -a orphans -d 'markdown orphans command'
complete -c xray -n '__fish_seen_subcommand_from markdown' -a code-refs -d 'markdown code-refs command'
complete -c xray -n '__fish_seen_subcommand_from markdown' -a coverage -d 'markdown coverage command'
complete -c xray -n '__fish_seen_subcommand_from markdown' -a stale -d 'markdown stale command'

complete -c xray -n '__fish_seen_subcommand_from package-manager' -a list-dependencies -d 'package-manager list-dependencies command'
complete -c xray -n '__fish_seen_subcommand_from package-manager' -a summary -d 'package-manager summary command'

complete -c xray -n '__fish_seen_subcommand_from react' -a components -d 'react components command'
complete -c xray -n '__fish_seen_subcommand_from react' -a hooks -d 'react hooks command'
complete -c xray -n '__fish_seen_subcommand_from react' -a contexts -d 'react contexts command'

complete -c xray -n '__fish_seen_subcommand_from rest-api' -a endpoints -d 'rest-api endpoints command'
complete -c xray -n '__fish_seen_subcommand_from rest-api' -a methods -d 'rest-api methods command'
complete -c xray -n '__fish_seen_subcommand_from rest-api' -a middleware -d 'rest-api middleware command'

# Global options
complete -c xray -s p -l path -d 'Project path' -r
complete -c xray -s o -l output -d 'Output file path' -r
complete -c xray -l graph -d 'Load graph from file' -r
complete -c xray -l format -d 'Output format' -xa 'txt csv xml json mermaid dot table tree text'
complete -c xray -s h -l help -d 'Display help'

--- stderr ---
"
`;

exports[`cli golden: introspection completion zsh 1`] = `
"exit: 0
--- stdout ---
# xray completion for zsh
# Add to ~/.zshrc:
# eval "$(xray completion zsh)"

#compdef xray

_xray() {
  local -a commands
  commands=(
    'map:Generate visual map of codebase'
    'scan:Scan and discover files'
    'graph:Generate CFG and DFG graphs'
    'generate:Generate analysis visualization'
    'query:Query call graph'
    'strategy:Manage strategies'
    'alias:Manage aliases'
    'lang:Manage language packs (tree-sitter grammars)'
    'explore:Find files and search code'
    'clear-cache:Clear SQLite cache'
    'completion:Generate shell completion'
    'help:Display help'
  )

  _arguments -C \\
    '1: :->command' \\
    '*::arg:->args' \\
    '(-p --path)'{-p,--path}'[Project path]:path:_files -/' \\
    '(-o --output)'{-o,--output}'[Output file path]:file:_files' \\
    '--graph[Load graph from file]:file:_files' \\
    '--format[Output format]:format:(txt csv xml json mermaid dot table tree text)' \\
    '(-h --help)'{-h,--help}'[Display help]'

  case $state in
    command)
      _describe 'command' commands
      ;;
    args)
      case "\${words[1]}" in
    build)
      local -a build_commands
      build_commands=(
      'targets:build targets command'
      'graph:build graph command'
      'run:build run command'
      )
      _describe 'build commands' build_commands
      ;;
    cicd)
      local -a cicd_commands
      cicd_commands=(
      'workflows:cicd workflows command'
      'graph:cicd graph command'
      'deploy:cicd deploy command'
      'triggers:cicd triggers command'
      )
      _describe 'cicd commands' cicd_commands
      ;;
    config)
      local -a config_commands
      config_commands=(
      'list:config list command'
      'keys:config keys command'
      'values:config values command'
      )
      _describe 'config commands' config_commands
      ;;
    container)
      local -a container_commands
      container_commands=(
      'analyze:container analyze command'
      'services:container services command'
      'stages:container stages command'
      )
      _describe 'container commands' container_commands
      ;;
    express)
      local -a express_commands
      express_commands=(
      'routes:express routes command'
      'routers:express routers command'
      'middleware:express middleware command'
      'error-handlers:express error-handlers command'
      )
      _describe 'express commands' express_commands
      ;;
    go-cli)
      local -a go-cli_commands
      go-cli_commands=(
      'commands:go-cli commands command'
      )
      _describe 'go-cli commands' go-cli_commands
      ;;
    infrastructure)
      local -a infrastructure_commands
      infrastructure_commands=(
      'resources:infrastructure resources command'
      'providers:infrastructure providers command'
      'graph:infrastructure graph command'
      'summary:infrastructure summary command'
      'validate:infrastructure validate command'
      )
      _describe 'infrastructure commands' infrastructure_commands
      ;;
    markdown)
      local -a markdown_commands
      markdown_commands=(
      'toc:markdown toc command'
      'refs:markdown refs command'
      'orphans:markdown orphans command'
      'code-refs:markdown code-refs command'
      'coverage:markdown coverage command'
      'stale:markdown stale command'
      )
      _describe 'markdown commands' markdown_commands
      ;;
    package-manager)
      local -a package-manager_commands
      package-manager_commands=(
      'list-dependencies:package-manager list-dependencies command'
      'summary:package-manager summary command'
      )
      _describe 'package-manager commands' package-manager_commands
      ;;
    react)
      local -a react_commands
      react_commands=(
      'components:react components command'
      'hooks:react hooks command'
      'contexts:react contexts command'
      )
      _describe 'react commands' react_commands
      ;;
    rest-api)
      local -a rest-api_commands
      rest-api_commands=(
      'endpoints:rest-api endpoints command'
      'methods:rest-api methods command'
      'middleware:rest-api middleware command'
      )
      _describe 'rest-api commands' rest-api_commands
      ;;
      esac
      ;;
  esac
}

_xray

--- stderr ---
"
`;

exports[`cli golden: introspection describe 1`] = `
"{
  "$schema": "https://hop-top.dev/schemas/cli-capabilities/v1.json",
  "tool": "xray",
  "version": "<VERSION>",
  "spec": "12fc/v1",
  "exitCodes": {
    "0": "success",
    "1": "generic failure",
    "2": "usage error (bad flag, missing arg)",
    "3": "not found (alias, config, strategy, path)",
    "4": "unauthorized / permission denied",
    "5": "conflict (resource collision)"
  },
  "commands": [
    {
      "name": "map",
      "qualifiedName": "map",
      "description": "Generate visual map of codebase",
      "hidden": false,
      "arguments": [],
      "options": [
        {
          "name": "--path",
          "short": "-p",
          "type": "string",
          "required": false,
          "default": [],
          "description": "Root directory to analyze (repeatable; with --format json|csv|xml all roots merge into one graph) [default: current directory]"
        },
        {
          "name": "--output",
          "short": "-o",
          "type": "string",
          "required": false,
          "default": null,
          "description": "Output file path [default: .xray, auto-appends format extension if no extension given; csv writes <out>.nodes.csv and <out>.edges.csv]"
        },
        {
          "name": "--limit",
          "short": "-l",
          "type": "number",
          "required": false,
          "default": null,
          "description": "Token limit per chunk [default: 4096]"
        },
        {
          "name": "--with",
          "short": "-w",
          "type": "string",
          "required": false,
          "default": [],
          "description": "Include feature: vars, incs, cost, docs, df, cf (repeatable)"
        },
        {
