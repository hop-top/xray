                                      (repeatable) (default: [])
  --disable-surface <name:surface>    Disable an extension surface at runtime
                                      (repeatable) (default: [])
  --binary <path>                     Run this prebuilt binary (\`spec --format
                                      json\`) inside an OS sandbox
  --exec-binary                       Build the main package and run it for its
                                      kit toolspec, inside an OS sandbox
  --unsafe-no-sandbox                 Allow --exec-binary/--binary without an
                                      OS sandbox (runs repo code unconfined)
  --allow-cgo                         With --exec-binary: build with cgo
                                      enabled (runs the C toolchain on repo
                                      code)
  --format <text|json>                Output format: text|json (default text)
  -h, --help                          display help for command

--- stderr ---
"
`;

