exports[`cli golden: --help xray build --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray build [options] [command]

Inspect build targets and dependencies (Makefile, package.json scripts)

COMMANDS:
  targets [--flags]        Show all build targets
  graph [--flags]          Show build dependency graph
  run [--flags]            Print the command for a build target (does not run
                           it; see \`build exec\`)
  exec <target> [--flags]  Run a build target (executes the repo's build recipe)

FLAGS:
  -h, --help               Display help


--- stderr ---
"
`;

exports[`cli golden: --help xray build exec --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray build exec [options] <target>

Run a build target (executes the repo's build recipe)

ARGUMENTS:
  target                              Target name to run

FLAGS:
  -p, --path <path>                   Project path to analyze (default: current
                                      directory)
  --enable-extension <name>           Enable an extension at runtime
                                      (repeatable) (default: [])
  --disable-extension <name>          Disable an extension at runtime
                                      (repeatable) (default: [])
  --extension-threshold <name=value>  Override an extension threshold at runtime
                                      (repeatable) (default: [])
  --extension-hint <name=value>       Add an extension hint at runtime
                                      (repeatable) (default: [])
  --enable-surface <name:surface>     Enable an extension surface at runtime
                                      (repeatable) (default: [])
  --disable-surface <name:surface>    Disable an extension surface at runtime
                                      (repeatable) (default: [])
  --format <fmt>                      Output format: text, json, yaml, table,
                                      csv; dot for graph commands (default:
                                      "text")
  -h, --help                          Display help


--- stderr ---
"
`;

