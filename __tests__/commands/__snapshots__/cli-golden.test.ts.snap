      ],
      "options": [
        {
          "name": "--path",
          "short": "-p",
          "type": "string",
          "required": false,
          "default": [],
          "description": "Root directory to analyze (repeatable; with --format json|csv|xml all roots merge into one graph) [default: current directory]"
        },
        {
          "name": "--output",
          "short": "-o",
          "type": "string",
          "required": false,
          "default": null,
          "description": "Output file path, or - for stdout (one document; not csv) [default: .xray, auto-appends format extension if no extension given; csv writes <out>.nodes.csv and <out>.edges.csv]"
        },
        {
          "name": "--limit",
          "short": "-l",
          "type": "number",
          "required": false,
          "default": null,
          "description": "Token limit per chunk [default: 4096]"
        },
        {
          "name": "--with",
          "short": "-w",
          "type": "string",
          "required": false,
          "default": [],
          "description": "Include feature: vars, incs, cost, docs, df, cf (repeatable) [df, cf: TypeScript, JavaScript, Python, Go]"
        },
        {
          "name": "--anchor",
          "short": "-a",
          "type": "string",
          "required": false,
          "default": null,
