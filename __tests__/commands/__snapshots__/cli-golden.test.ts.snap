exports[`cli golden: --help xray graph --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray graph [options] [paths...]

Generate control flow (CFG) and data flow (DFG) graphs

ARGUMENTS:
  paths                               Root directories to analyze (same as
                                      --path; not combinable with it)

FLAGS:
  -p, --path <path>                   Root directory to analyze (repeatable;
                                      with --format json|csv|xml all roots merge
                                      into one graph) [default: current
                                      directory] (default: [])
  -o, --output <path>                 Output file path, or - for stdout (one
                                      document; not csv) [default: .xray,
                                      auto-appends format extension if no
                                      extension given; csv writes
                                      <out>.nodes.csv and <out>.edges.csv]
  -l, --limit <number>                Token limit per chunk [default: 4096]
  -w, --with <feature>                Include feature: vars, incs, cost, docs,
                                      df, cf (repeatable); cf and df are on
                                      unless one is named, then only those
                                      [TypeScript, JavaScript, Python, Go]
                                      (default: [])
  -a, --anchor <path>                 Focus on specific file (Personalized
                                      PageRank)
  -d, --depth <number>                Maximum depth of tree to render
  -q, --query <item>                  Override query (e.g. .ts:path,
                                      path/to/dir, url) (repeatable) (default:
                                      [])
  -m, --match <pattern>               Match filename pattern (prefix ! to
                                      negate) (repeatable) (default: [])
  -c, --catch <pattern>               Match function/class name (prefix ! to
                                      negate) (repeatable) (default: [])
  --format <fmt>                      Output format: txt (default), json, csv
                                      (nodes+edges tables), xml
  --txt                               Alias of --format txt
  --csv                               Alias of --format csv (<out>.nodes.csv +
                                      <out>.edges.csv)
  --xml                               Alias of --format xml (one <graph>
                                      document)
  --json                              Alias of --format json (raw JSON graph)
  --no-chunk                          Disable chunked output (single file
                                      output)
  --group <mode>                      Chunk grouping mode: directory (default)
                                      or community (default: "directory")
  --lens <name>                       Use named lens (config-file option
                                      overlay)
  --scope <name>                      Use specific scope from config file
  --all-scopes                        Run all scopes defined in config file
  --detect                            Enable strategy detection (auto-detects
                                      when no path is provided)
  --lang <list>                       Languages to parse, comma-separated names
                                      or bundles (e.g. go,ts or web); overrides
                                      config \`languages\`; each must be installed
                                      (repeatable) (default: [])
  --skip-detect                       Skip strategy detection and
                                      auto-configuration
  --share [path]                      Generate a shareable summary markdown
                                      (optional path override)
  --preset <spec>                     Apply a plugin preset (built-in name,
                                      ./local/path, or @scope/pkg). Repeatable.
                                      Built-ins: insights, onboarding,
                                      exploration. (default: [])
  --enable-extension <name>           Enable an extension at runtime
                                      (repeatable) (default: [])
  --disable-extension <name>          Disable an extension at runtime
                                      (repeatable) (default: [])
  --extension-threshold <name=value>  Override an extension threshold at runtime
                                      (repeatable) (default: [])
  --extension-hint <name=value>       Add an extension hint at runtime
                                      (repeatable) (default: [])
  --enable-surface <name:surface>     Enable an extension surface at runtime
                                      (repeatable) (default: [])
  --disable-surface <name:surface>    Disable an extension surface at runtime
                                      (repeatable) (default: [])
  -h, --help                          Display help


--- stderr ---
"
`;

