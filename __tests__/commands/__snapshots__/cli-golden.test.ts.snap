// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`cli golden: --help xray (root) --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray [options] [command]

X-ray your codebase - Generate AST, CFG, and DFG visualizations

ANALYZE:
  map [paths] [--flags]      Generate visual map of codebase
  graph [paths] [--flags]    Generate control flow (CFG) and data flow (DFG)
                             graphs
  query [query] [--flags]    Query call graph using function-based syntax
  impact <symbol> [--flags]  Show transitive callers of a symbol, by area
  imports [paths] [--flags]  List every file's imports as the xray.imports/v1
                             JSON contract
  explore [--flags]          Quickly find files by patterns, search code for
                             keywords, or explore codebase [default command]

STRATEGY:
  strategy [command]         Manage strategies (list, create, install, remove,
                             enable, disable, info)
  build [command]            Inspect build targets and dependencies (Makefile,
                             package.json scripts)
  cicd [command]             Inspect CI/CD workflows, triggers and deployments
  config-files [command]     Inspect project configuration files, keys and
                             values
  container [command]        Inspect Dockerfiles and docker-compose services
  express [command]          Inspect Express routes, routers, middleware and
                             error handlers
  go-cli [command]           Show the command tree of Go CLI apps (cobra/kit)
  infrastructure [command]   Inspect infrastructure-as-code resources, providers
                             and dependencies
  markdown [command]         Analyze markdown docs: TOC, cross-references,
                             orphans, coverage, broken links
  package-manager [command]  List dependencies across package managers (npm,
                             pip, cargo, go, ...)
  react [command]            Inspect React components, hooks and contexts
  rest-api [command]         Inspect REST API endpoints and middleware across
                             frameworks

MANAGEMENT:
  alias [command]            Manage command aliases
  lang [command]             Manage language packs (tree-sitter grammars)
  cache [command]            Cache management
  paths [--flags]            Show xray's active config, cache DB, and project
                             root
  describe [--flags]         Emit machine-readable capability surface (12fc
                             Factor 1)
  upgrade [--flags]          Check whether a newer xray release is available
                             (--check)
  mcp [--flags]              Serve analysis commands as MCP tools over stdio
  completion [command]       Generate the autocompletion script for the
                             specified shell

FLAGS:
  -v, --version              Print xray version and exit
  --quiet                    Suppress non-essential output (default: false)
  --no-color                 Disable ANSI colour
  --no-hints                 Suppress next-step hints after command output
  --offline                  Disable network access (default: false)
  -V, --verbose              Increase verbosity
  --help-analyze             Show ANALYZE commands
  --help-strategy            Show STRATEGY commands
  --help-management          Show MANAGEMENT commands
  --log-level <level>        Set log level: silent, error, warn, info, debug
                             (default: info; overrides -V)
  --config <path>            Path to config file (auto-detect if not specified)
  --no-telemetry             Disable telemetry for this session
  -C, --chdir <path>         Change to <path> before running the command
  --help-all                 Show every command with its flags
  -h, --help                 Display help


--- stderr ---
"
`;

exports[`cli golden: --help xray alias --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray alias [options] [command]

Manage command aliases

COMMANDS:
  list [--flags]                 List all configured aliases
  set <name> <target> [--flags]  Create or update an alias
  remove <name> [--flags]        Remove an alias

FLAGS:
  -h, --help                     Display help


--- stderr ---
"
`;

exports[`cli golden: --help xray alias list --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray alias list [options]

List all configured aliases

FLAGS:
  --format <fmt>  Output format: text, json, yaml, table, csv (default: "text")
  -h, --help      Display help


--- stderr ---
"
`;

