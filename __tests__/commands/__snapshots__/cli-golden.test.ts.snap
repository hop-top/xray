exports[`cli golden: --help xray explore --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray explore [options] [query]

Quickly find files by patterns, search code for keywords, or explore codebase
[default command]

Arguments:
  query                   Search query or pattern

Options:
  -p, --path <path>       Root directory to explore (repeatable) [default:
                          current directory] (default: [])
  -m, --match <pattern>   Find files matching pattern (e.g., "*.ts",
                          "**/*test*") (repeatable) (default: [])
  -s, --search <keyword>  Search for keyword in code (repeatable) (default: [])
  -t, --type <ext>        Filter by file extension (e.g., ts, js, py)
                          (repeatable) (default: [])
  --stats                 Show codebase statistics
  --list-strategies       List all available strategies
  -h, --help              display help for command

--- stderr ---
"
`;

