exports[`cli golden: --help xray explore --help 1`] = `
"exit: 0
--- stdout ---
Usage: xray explore [options]

Quickly find files by patterns, search code for keywords, or explore codebase [default command]

FLAGS:
  -p, --path <path>       Root directory to explore (repeatable) [default:
                          current directory] (default: [])
  -m, --match <pattern>   Find files matching pattern (e.g., "*.ts",
                          "**/*test*"); with --search or --stats, restricts them
                          to these files (repeatable) (default: [])
  -s, --search <keyword>  Search for keyword in code (repeatable) (default: [])
  -t, --type <ext>        Filter by file extension (e.g., ts, js, py)
                          (repeatable) (default: [])
